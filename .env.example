# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real keys.

# Required: OpenAI API key used by the LangChain agent.
OPENAI_API_KEY=

# Optional: OpenAI model name. Defaults to gpt-5.6-terra when unset.
OPENAI_MODEL=gpt-5.6-terra

# Optional: U.S. Census Bureau API key (free, from
# https://api.census.gov/data/key_signup.html). Needed for county
# demographics and the healthcare-access analysis; without it those
# tools still run but report demographics as unavailable.
CENSUS_API_KEY=


# Optional private PostgreSQL snapshots; never put real credentials in this template.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# FINANCIAL_DATA_MODE=database_only

# Enable only after reference snapshots have been imported.
# REFERENCE_DATA_MODE=database_only
